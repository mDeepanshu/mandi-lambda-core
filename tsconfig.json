{
  "extends": "./tsconfig.paths.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "lib": ["ESNext"],
    "target": "ES2022",

    "module": "Node16",
    "moduleResolution": "node16",

    "types": ["node"],

    // pinned so ts-node can resolve an entry point under scripts/ as well as
    // src/ — without it, running a script directly fails with TS5011
    "rootDir": ".",
    "outDir": "lib",
    "sourceMap": true,
    "removeComments": true,

    "strict": true,
    "esModuleInterop": true,

    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*.ts", "scripts/**/*.ts", "serverless.ts"]
}