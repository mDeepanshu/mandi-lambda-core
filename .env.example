# Copy to .env and fill in. Get the connection string from the Supabase
# dashboard: Settings -> Database -> Connection string (URI).
# Admin/migration use only — the Lambda runtime does not read this file.
SUPABASE_DB_URL_DEV=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres
SUPABASE_DB_URL_HIS=
SUPABASE_DB_URL_HMB=

# Sarvam TTS. Used by `npm run seed:tts` to render the Hindi clip alphabet once
# per stage, and exported to the shell before `sls deploy` so the tts Lambda can
# render a token that was never seeded. Never commit the value.
SARVAM_API_KEY=

# Supabase project URL + secret key per stage. Read by serverless.ts and
# injected into each Lambda as SUPABASE_URL / SUPABASE_KEY. Get these from the
# Supabase dashboard: Settings -> API. Never commit the real values.
SUPABASE_URL_DEV=https://PROJECT_REF.supabase.co
SUPABASE_KEY_DEV=
SUPABASE_URL_HIS=
SUPABASE_KEY_HIS=
SUPABASE_URL_HMB=
SUPABASE_KEY_HMB=
